# Core runtime
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/delsu_compass
CLIENT_URL=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Only needed for npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_FULL_NAME=DELSU Compass Administrator

# In-app road routing
OPENROUTESERVICE_API_KEY=replace_with_your_openrouteservice_key
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/openrouteservice/v2

# Resend email delivery
RESEND_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=DELSU Compass <onboarding@resend.dev>

# Cloudinary media storage
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=delsu-compass
